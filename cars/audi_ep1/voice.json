[
 {
  "beat": 0,
  "text": "Audi badges, explained in under a minute.",
  "start": 0.35,
  "end": 2.793
 },
 {
  "beat": 1,
  "text": "A is the normal car.",
  "start": 2.993,
  "end": 4.391
 },
 {
  "beat": 1,
  "text": "A3, A4, A6.",
  "start": 4.591,
  "end": 6.242
 },
 {
  "beat": 1,
  "text": "The number just tells you how big it is.",
  "start": 6.442,
  "end": 8.66
 },
 {
  "beat": 2,
  "text": "Q means it's an SUV.",
  "start": 8.86,
  "end": 10.869
 },
 {
  "beat": 2,
  "text": "Same rule. Q3 is small, Q7 is big.",
  "start": 11.069,
  "end": 14.05
 },
 {
  "beat": 3,
  "text": "S is the sporty one.",
  "start": 14.25,
  "end": 15.677
 },
 {
  "beat": 3,
  "text": "An S3 is an A3 with more power and firmer suspension.",
  "start": 15.877,
  "end": 19.536
 },
 {
  "beat": 4,
  "text": "RS stands for RennSport.",
  "start": 19.736,
  "end": 21.805
 },
 {
  "beat": 4,
  "text": "That's German for racing sport.",
  "start": 22.005,
  "end": 23.876
 },
 {
  "beat": 4,
  "text": "It's the top of the range.",
  "start": 24.076,
  "end": 25.562
 },
 {
  "beat": 5,
  "text": "And the first RS ever sold?",
  "start": 25.762,
  "end": 27.741
 },
 {
  "beat": 5,
  "text": "An estate.",
  "start": 27.861,
  "end": 28.646
 },
 {
  "beat": 5,
  "text": "The RS2 Avant, built with Porsche, in 1994.",
  "start": 28.846,
  "end": 32.505
 },
 {
  "beat": 6,
  "text": "Avant is just Audi's word for estate.",
  "start": 32.705,
  "end": 34.985
 },
 {
  "beat": 6,
  "text": "Sportback means a sloping roof at the back.",
  "start": 35.185,
  "end": 37.315
 },
 {
  "beat": 7,
  "text": "Quattro is all-wheel drive.",
  "start": 37.515,
  "end": 39.213
 },
 {
  "beat": 7,
  "text": "Audi made it famous in rallying,",
  "start": 39.413,
  "end": 41.385
 },
 {
  "beat": 7,
  "text": "and they still write it with a small q.",
  "start": 41.505,
  "end": 43.627
 },
 {
  "beat": 8,
  "text": "Now the bit nobody knows.",
  "start": 43.827,
  "end": 45.441
 },
 {
  "beat": 8,
  "text": "The number on the boot, like 35 or 45, isn't the engine size.",
  "start": 45.641,
  "end": 50.184
 },
 {
  "beat": 8,
  "text": "It's a power band.",
  "start": 50.384,
  "end": 51.47
 },
 {
  "beat": 8,
  "text": "Bigger number, more power.",
  "start": 51.67,
  "end": 53.144
 },
 {
  "beat": 9,
  "text": "TFSI is a petrol turbo.",
  "start": 53.344,
  "end": 55.682
 },
 {
  "beat": 9,
  "text": "TDI is diesel.",
  "start": 55.882,
  "end": 57.54
 },
 {
  "beat": 9,
  "text": "TFSI e is a plug-in hybrid.",
  "start": 57.74,
  "end": 60.276
 },
 {
  "beat": 9,
  "text": "And e-tron is fully electric.",
  "start": 60.476,
  "end": 62.312
 },
 {
  "beat": 10,
  "text": "S line?",
  "start": 62.512,
  "end": 63.245
 },
 {
  "beat": 10,
  "text": "That's just the look.",
  "start": 63.365,
  "end": 64.405
 },
 {
  "beat": 10,
  "text": "Bigger wheels, sharper bumpers, same engine.",
  "start": 64.605,
  "end": 67.129
 },
 {
  "beat": 11,
  "text": "So S line looks fast.",
  "start": 67.329,
  "end": 68.786
 },
 {
  "beat": 11,
  "text": "S is fast.",
  "start": 68.986,
  "end": 69.995
 },
 {
  "beat": 11,
  "text": "And RS is the one you hear before you see it.",
  "start": 70.195,
  "end": 72.788
 }
]